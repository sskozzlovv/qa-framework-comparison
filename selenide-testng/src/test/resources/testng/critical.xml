<?xml version="1.0" encoding="UTF-8"?>
<!--
  Critical path, listed by CLASS and METHOD instead of a package scan.   ./mvnw -pl selenide-testng -am test -Dsuite=critical
  Shows the other way to build a suite: an explicit list. The group filter still applies on top of it.
-->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenide + TestNG: critical" parallel="classes" thread-count="2">

    <listeners>
        <listener class-name="com.compare.testng.listeners.ConsoleLogListener"/>
    </listeners>

    <test name="Critical path">
        <groups>
            <run>
                <include name="critical"/>
            </run>
        </groups>
        <classes>
            <!-- whole class: all its "critical" methods -->
            <class name="com.compare.testng.tests.CartTest"/>
            <!-- only the listed method of this class -->
            <class name="com.compare.testng.tests.CheckoutTest">
                <methods>
                    <include name="userBuysProductsAndOrderGetsCompleted"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
