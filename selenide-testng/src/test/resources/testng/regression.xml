<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Regression as TWO <test> blocks of one suite.   ./mvnw -pl selenide-testng -am test -Dsuite=regression
  A <test> is a named part of the run: it has its own groups, classes and parameters, and its own
  @BeforeTest/@AfterTest. Blocks run one after another (parallel="tests" would run them at the same time).
-->
<suite name="Selenide + TestNG: regression" parallel="classes" thread-count="3">

    <parameter name="headless" value="true"/>

    <listeners>
        <listener class-name="com.compare.testng.listeners.RetryTransformer"/>
        <listener class-name="com.compare.testng.listeners.ConsoleLogListener"/>
    </listeners>

    <test name="Shop regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.compare.testng.tests"/>
        </packages>
    </test>

    <test name="Browser features">
        <groups>
            <run>
                <include name="browser-api"/>
            </run>
        </groups>
        <classes>
            <class name="com.compare.testng.tests.PlaygroundTest"/>
            <class name="com.compare.testng.tests.JavaScriptAndScreenshotsTest"/>
        </classes>
    </test>
</suite>
