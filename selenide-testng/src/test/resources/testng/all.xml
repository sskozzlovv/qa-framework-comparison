<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Default suite (./mvnw -pl selenide-testng -am test): every test except the deliberately failing one.

  suite attributes:
    parallel="classes"   test CLASSES run in parallel, methods of one class sequentially in one thread
    thread-count="3"     3 threads = 3 browsers at the same time
-->
<suite name="Selenide + TestNG: all" parallel="classes" thread-count="3">

    <!-- Suite parameters -> @Parameters({"browser", "headless"}) in BaseTest.beforeSuite. -D... still wins. -->
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>

    <!-- Listeners for the whole suite. RetryTransformer MUST be here: an IAnnotationTransformer in @Listeners is ignored. -->
    <listeners>
        <listener class-name="com.compare.testng.listeners.RetryTransformer"/>
        <listener class-name="com.compare.testng.listeners.ConsoleLogListener"/>
    </listeners>

    <test name="All tests">
        <groups>
            <run>
                <exclude name="demo-failure"/>
            </run>
        </groups>
        <packages>
            <package name="com.compare.testng.tests"/>
        </packages>
    </test>
</suite>
