<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Smoke: only the "smoke" group from the whole package.   ./mvnw -pl selenide-testng -am test -Dsuite=smoke
  JUnit 5 equivalent: suites/SmokeSuite.java (@Suite + @IncludeTags("smoke")) or -Dgroups=smoke.
-->
<suite name="Selenide + TestNG: smoke" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="com.compare.testng.listeners.RetryTransformer"/>
        <listener class-name="com.compare.testng.listeners.ConsoleLogListener"/>
    </listeners>

    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.compare.testng.tests"/>
        </packages>
    </test>
</suite>
